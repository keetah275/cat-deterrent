[Unit]
Description=Garden monitoring dashboard
After=network.target
StartLimitIntervalSec=0

[Service]
User=keets27
WorkingDirectory=/home/keets27/cat-deterrent
ExecStart=/usr/bin/python3 /home/keets27/cat-deterrent/garden_dashboard.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
