[Unit]
Description=Garden RTSP motion detector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=keets27
WorkingDirectory=/home/keets27/cat-deterrent
EnvironmentFile=/home/keets27/cat-deterrent/camera-service.env
Environment=PYTHONUNBUFFERED=1
Environment="OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp"
Environment=OPENCV_FFMPEG_THREADS=1
ExecStart=/home/keets27/cat-deterrent/.venv/bin/python -u /home/keets27/cat-deterrent/motion_detector.py --config /home/keets27/cat-deterrent/config-tc41-night.json
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
